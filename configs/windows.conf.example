# LES-NET Windows (official WireGuard client, IPv4 split tunnel)
# Home Ubuntu VM under Proxmox is the SERVER. NO external VPS.
# Generate a unique key pair on Windows, keep the private key on Windows.
[Interface]
PrivateKey = <WINDOWS_PRIVATE_KEY>
Address = 10.77.0.10/32

[Peer]
PublicKey = <HOME_SERVER_PUBLIC_KEY>
Endpoint = <HOME_PUBLIC_IPV4_OR_DNS>:51820
AllowedIPs = 10.77.0.0/24
PersistentKeepalive = 25

# Full IPv4 through home: change AllowedIPs to 0.0.0.0/0 ONLY
# after enabling authorized forwarding/NAT on the home Ubuntu server.
# IPv6 and DNS leak handling is not provided here.
