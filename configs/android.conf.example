# LES-NET Android (official WireGuard client, IPv4 split tunnel)
# Connect DIRECTLY to the public IP/DNS of the HOME Ubuntu server.
# Generate a unique pair of keys in Android WireGuard; keep private key on device.
[Interface]
PrivateKey = <ANDROID_PRIVATE_KEY>
Address = 10.77.0.11/32

[Peer]
PublicKey = <HOME_SERVER_PUBLIC_KEY>
Endpoint = <HOME_PUBLIC_IPV4_OR_DNS>:51820
AllowedIPs = 10.77.0.0/24
PersistentKeepalive = 25

# Full IPv4 through home: change AllowedIPs to 0.0.0.0/0 ONLY
# after configuring forwarding/NAT at home. IPv6/DNS need separate handling.
